@font-face {
    font-family: "MICEI Sans";
    src: url("../fonts/HyundaiSansTextOffice-Medium.ttf") format("truetype");
    font-display: swap;
}
@font-face {
    font-family: "MICEI Head";
    src: url("../fonts/HyundaiSansHeadOffice-Bold.ttf") format("truetype");
    font-display: swap;
}

:root {
    --red: #bf1f2f;
    --red-dark: #991927;
    --red-soft: #f8dde1;
    --ink: #20242b;
    --muted: #6f747c;
    --line: #dfe2e6;
    --surface: #ffffff;
    --page: #f2f1f0;
    --success: #16735a;
    --warning: #a35c08;
    --danger: #b4232f;
    --blue: #3866a4;
    font-family: "MICEI Sans", "Segoe UI", Arial, sans-serif;
}
* { box-sizing: border-box; }
html { min-width: 320px; }
body {
    margin: 0;
    color: var(--ink);
    background:
        radial-gradient(circle at 8% 4%, #f8dde1 0, transparent 22%),
        linear-gradient(145deg, #f7f7f8 0%, #f0eeec 52%, #f6f5f4 100%);
}
a { color: inherit; }
.app-shell { min-height: 100vh; display: grid; grid-template-columns: 250px 1fr; }
.sidebar { position: sticky; top: 0; height: 100vh; background: #111827; color: #fff; padding: 22px 16px; display: flex; flex-direction: column; }
.brand { display: flex; gap: 12px; align-items: center; color: #fff; text-decoration: none; padding: 4px 7px 22px; }
.brand-mark { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--red); font-weight: 900; }
.brand-mark img { display: block; width: 42px; height: 42px; border-radius: 12px; object-fit: cover; }
.brand strong, .brand small { display: block; }
.brand small { margin-top: 2px; color: #9ca3af; font-size: 11px; }
.sidebar nav { display: grid; gap: 6px; }
.sidebar nav a { text-decoration: none; padding: 12px 14px; border-radius: 9px; color: #d1d5db; }
.sidebar nav a:hover, .sidebar nav a.active { background: #283244; color: white; }
.sidebar-user { margin-top: auto; padding: 15px 10px 3px; border-top: 1px solid #374151; }
.sidebar-user strong, .sidebar-user small { display: block; }
.sidebar-user small { color: #9ca3af; margin: 4px 0 10px; }
.sidebar-user a { color: #fca5a5; font-size: 13px; }
.main-content { padding: 28px; min-width: 0; }
.topbar { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px; }
.topbar h1 { font-size: 28px; margin: 0; }
.topbar p { color: var(--muted); margin: 6px 0 0; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 3px 16px rgba(17,24,39,.04); }
.card-body { padding: 22px; }
.card-header { padding: 18px 22px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.card-header h2, .card-header h3 { margin: 0; }
.grid { display: grid; gap: 18px; }
.grid-4 { grid-template-columns: repeat(4, minmax(0,1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0,1fr)); }
.grid-2 { grid-template-columns: repeat(2, minmax(0,1fr)); }
.stat { padding: 20px; }
.stat .label { color: var(--muted); font-size: 13px; }
.stat .value { font-size: 30px; font-weight: 800; margin-top: 7px; }
.stat .hint { font-size: 12px; color: var(--muted); margin-top: 5px; }
.actions { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 39px; border: 1px solid transparent; border-radius: 9px; padding: 9px 14px; font: inherit; font-size: 14px; font-weight: 650; text-decoration: none; cursor: pointer; }
.btn-primary { background: var(--red); color: white; }
.btn-primary:hover { background: var(--red-dark); }
.btn-secondary { background: white; border-color: var(--line); color: var(--ink); }
.btn-release { background: #2563eb; border-color: #2563eb; color: white; box-shadow: 0 8px 18px rgba(37,99,235,.2); }
.btn-release:hover { background: #1d4ed8; border-color: #1d4ed8; }
.btn-danger { background: #fff1f2; border-color: #fecdd3; color: var(--danger); }
.btn-sm { min-height: 32px; padding: 6px 10px; font-size: 12px; }
.btn-icon { width: 16px; height: 16px; flex: 0 0 16px; }
.btn-sm .btn-icon { width: 14px; height: 14px; flex-basis: 14px; }
form { margin: 0; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px; }
.form-group { display: grid; gap: 7px; }
.form-group.full { grid-column: 1 / -1; }
label { font-weight: 650; font-size: 13px; }
input, select, textarea { width: 100%; border: 1px solid #d1d5db; background: white; border-radius: 9px; padding: 10px 11px; font: inherit; color: var(--ink); }
input:focus, select:focus, textarea:focus { outline: 3px solid rgba(215,25,32,.12); border-color: var(--red); }
textarea { min-height: 92px; resize: vertical; }
.help { font-size: 12px; color: var(--muted); }
.required { color: var(--red); }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; }
th, td { padding: 13px 15px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: middle; }
th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); background: #f9fafb; }
td { font-size: 14px; }
tr:last-child td { border-bottom: 0; }
.badge { display: inline-flex; align-items: center; padding: 4px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; }
.badge-active { background: #d1fae5; color: #065f46; }
.badge-inactive { background: #fee2e2; color: #991b1b; }
.badge-action { background: #eff6ff; color: #1d4ed8; }
.badge-done { background: #d1fae5; color: #065f46; }
.badge-released { background: #dbeafe; color: #1e40af; }
.badge-pending { background: #fef3c7; color: #92400e; }
.status-detail { display: block; margin-top: 6px; color: var(--muted); white-space: nowrap; }
.avatar { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; background: #e5e7eb; border: 1px solid var(--line); }
.employee-cell { display: flex; align-items: center; gap: 11px; }
.employee-cell strong, .employee-cell small { display: block; }
.employee-cell small { color: var(--muted); margin-top: 2px; }
.filters { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 10px; align-items: end; }
.employee-filters { grid-template-columns: 2fr repeat(4, minmax(120px, 1fr)) auto; }
.alert { border-radius: 10px; padding: 12px 15px; margin-bottom: 16px; border: 1px solid; }
.alert-success { background: #ecfdf5; border-color: #a7f3d0; color: #065f46; }
.alert-danger { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
.alert-warning { background: #fffbeb; border-color: #fde68a; color: #92400e; }
.empty { text-align: center; color: var(--muted); padding: 38px; }
.detail-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 24px; }
.detail dt { color: var(--muted); font-size: 12px; margin-bottom: 4px; }
.detail dd { margin: 0; font-weight: 600; word-break: break-word; }
.id-status-message { display: flex; align-items: center; gap: 12px; color: #92400e; }
.id-status-message > .btn-icon { width: 22px; height: 22px; flex-basis: 22px; }
.id-status-message strong, .id-status-message span { display: block; }
.id-status-message span { margin-top: 3px; color: var(--muted); font-size: 13px; }
.section-title { margin: 0 0 15px; font-size: 16px; }
.mt-18 { margin-top: 18px; }
.mb-18 { margin-bottom: 18px; }
.auth-shell { min-height: 100vh; display: grid; place-items: center; padding: 20px; background: linear-gradient(135deg,#111827,#3f0a0d); }
.login-card { width: min(430px, 100%); background: white; border-radius: 18px; padding: 30px; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
.login-card h1 { margin: 0 0 6px; }
.login-card p { color: var(--muted); margin: 0 0 24px; }
.login-card .form-group { margin-bottom: 15px; }
.login-card .btn { width: 100%; margin-top: 5px; }
.id-layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 22px; align-items: start; }
.id-previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.id-panel { padding: 16px; text-align: center; }
.id-panel h3 { margin: 0 0 13px; }
.id-card-frame { max-width: 380px; margin: auto; background: #ddd; padding: 8px; border-radius: 10px; box-shadow: 0 12px 28px rgba(0,0,0,.12); }
.id-card-frame svg { display: block; width: 100%; height: auto; background: white; }
.id-template-selector { margin-top: 20px; }
.photo-placement-editor { margin: 20px 0; padding: 15px; border: 1px solid var(--line); border-radius: 10px; background: #f9fafb; }
.photo-placement-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.photo-placement-heading h4 { margin: 0; font-size: 15px; }
.photo-placement-heading p { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.4; }
.photo-range { display: grid; gap: 5px; margin-top: 11px; }
.photo-range > span { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; }
.photo-range output { color: var(--muted); font-variant-numeric: tabular-nums; }
.photo-range input[type="range"] { padding: 0; accent-color: var(--red); cursor: pointer; }
.id-card-frame.is-photo-dragging { outline: 3px solid rgba(215,25,32,.22); }
.photo-placement-editor .help { margin: 9px 0 0; }
.audit-description { max-width: 430px; }
.audit-description small { display: block; color: var(--muted); margin-top: 4px; }
.pagination { display: flex; gap: 6px; justify-content: flex-end; padding: 16px 20px; }
.pagination a { padding: 7px 11px; border: 1px solid var(--line); background: white; border-radius: 7px; text-decoration: none; }
.pagination a.active { color: white; background: var(--red); border-color: var(--red); }
.system-hub-body {
    min-height: 100vh;
    overflow-x: hidden;
    color: #20242b;
    background:
        linear-gradient(rgba(41, 47, 55, .025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(41, 47, 55, .025) 1px, transparent 1px),
        #f4f5f7;
    background-size: 32px 32px;
}
.system-hub-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
}
.system-hub-backdrop span {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    filter: blur(2px);
}
.system-hub-backdrop span:first-child {
    top: -310px;
    right: -140px;
    background: radial-gradient(circle, rgba(191,31,47,.1), rgba(191,31,47,0) 68%);
}
.system-hub-backdrop span:last-child {
    bottom: -390px;
    left: -120px;
    background: radial-gradient(circle, rgba(56,102,164,.08), rgba(56,102,164,0) 68%);
}
.system-hub {
    position: relative;
    z-index: 1;
    width: min(1400px, calc(100% - 48px));
    margin: 0 auto;
    padding: 18px 0 20px;
}
.system-hub-nav {
    min-height: 66px;
    padding: 9px 12px 9px 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border: 1px solid rgba(32,36,43,.08);
    border-radius: 20px;
    background: rgba(255,255,255,.88);
    box-shadow: 0 14px 36px rgba(28,32,39,.07);
    backdrop-filter: blur(18px);
}
.system-hub-brand {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #20242b;
    text-decoration: none;
}
.system-hub-brand-mark {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid #e2e4e8;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 7px 18px rgba(34,39,46,.08);
}
.system-hub-brand-mark img {
    width: 33px;
    height: 33px;
    display: block;
    object-fit: contain;
    border-radius: 8px;
}
.system-hub-brand small,
.system-hub-brand strong {
    display: block;
}
.system-hub-brand small {
    margin-bottom: 2px;
    color: #a51e2c;
    font-size: .63rem;
    font-weight: 800;
    letter-spacing: .14em;
}
.system-hub-brand strong {
    font-family: "MICEI Head", "Segoe UI", sans-serif;
    font-size: .98rem;
}
.system-hub-account {
    display: flex;
    align-items: center;
    gap: 10px;
}
.system-hub-account-copy {
    min-width: 0;
    margin-right: 2px;
    text-align: right;
}
.system-hub-account-copy small,
.system-hub-account-copy strong {
    display: block;
}
.system-hub-account-copy small {
    margin-bottom: 3px;
    color: #81868e;
    font-size: .66rem;
}
.system-hub-account-copy strong {
    max-width: 190px;
    overflow: hidden;
    color: #343940;
    font-size: .8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.system-hub-avatar {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    color: #fff;
    border-radius: 50%;
    background: #222831;
    font-family: "MICEI Head", "Segoe UI", sans-serif;
    font-size: .8rem;
    box-shadow: 0 5px 12px rgba(34,40,49,.16);
}
.system-hub-signout {
    min-height: 38px;
    margin-left: 4px;
    padding: 8px 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #595e66;
    border: 1px solid #e0e3e7;
    border-radius: 999px;
    background: #fff;
    font-size: .73rem;
    font-weight: 700;
    text-decoration: none;
    transition: color .18s ease, border-color .18s ease, background .18s ease;
}
.system-hub-signout svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.system-hub-signout:hover {
    color: #991927;
    border-color: #e8bdc3;
    background: #fff8f9;
}
.system-hub-header {
    margin: 30px 2px 20px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 36px;
}
.system-hub-intro {
    max-width: 690px;
}
.system-hub-eyebrow {
    margin-bottom: 9px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #8f1d29;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
}
.system-hub-eyebrow i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #bf1f2f;
    box-shadow: 0 0 0 5px rgba(191,31,47,.1);
}
.system-hub-header h1 {
    margin: 0;
    color: #20242b;
    font-family: "MICEI Head", "Segoe UI", sans-serif;
    font-size: clamp(2.15rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -.045em;
}
.system-hub-header p {
    max-width: 610px;
    margin: 10px 0 0;
    color: #70757d;
    font-size: .95rem;
    line-height: 1.65;
}
.system-hub-summary {
    min-width: 235px;
    padding: 11px 13px;
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid rgba(32,36,43,.08);
    border-radius: 16px;
    background: rgba(255,255,255,.72);
}
.system-hub-summary-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    color: #16735a;
    border-radius: 11px;
    background: #e3f3ed;
}
.system-hub-summary-icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.system-hub-summary strong,
.system-hub-summary small {
    display: block;
}
.system-hub-summary strong {
    color: #343940;
    font-size: .78rem;
}
.system-hub-summary small {
    margin-top: 4px;
    color: #858a91;
    font-size: .66rem;
}
.system-launcher-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}
.system-tile {
    --system-accent: #3866a4;
    --system-accent-soft: #eaf0f8;
    position: relative;
    min-height: 190px;
    padding: 15px 14px 13px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #20242b;
    border: 1px solid rgba(32,36,43,.09);
    border-radius: 17px;
    background: rgba(255,255,255,.92);
    box-shadow: 0 16px 40px rgba(28,32,39,.065);
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}
.system-tile::before {
    content: "";
    position: absolute;
    top: 0;
    left: 14px;
    width: 42px;
    height: 3px;
    border-radius: 0 0 999px 999px;
    background: var(--system-accent);
}
.system-tile::after {
    content: "";
    position: absolute;
    z-index: 0;
    top: -110px;
    right: -95px;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--system-accent-soft) 0, rgba(255,255,255,0) 69%);
    opacity: .7;
    transition: transform .3s ease, opacity .3s ease;
}
.system-tile > * {
    position: relative;
    z-index: 1;
}
.system-tile:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--system-accent) 28%, #dfe2e6);
    box-shadow: 0 22px 50px rgba(28,32,39,.105);
}
.system-tile:hover::after {
    transform: scale(1.12);
    opacity: 1;
}
.system-tile:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--system-accent) 35%, transparent);
    outline-offset: 4px;
}
.system-tile-red {
    --system-accent: #b82030;
    --system-accent-soft: #f8e3e6;
}
.system-tile-amber {
    --system-accent: #b76b18;
    --system-accent-soft: #f9eedf;
}
.system-tile-indigo {
    --system-accent: #6556a5;
    --system-accent-soft: #eeeaf8;
}
.system-tile-blue {
    --system-accent: #326ca0;
    --system-accent-soft: #e5eff7;
}
.system-tile-green {
    --system-accent: #27806a;
    --system-accent-soft: #e4f3ee;
}
.system-tile-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
}
.system-tile-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    color: var(--system-accent);
    border: 1px solid color-mix(in srgb, var(--system-accent) 12%, transparent);
    border-radius: 12px;
    background: var(--system-accent-soft);
}
.system-tile-icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.system-tile-state {
    padding: 5px 7px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #176650;
    border: 1px solid #d8ebe4;
    border-radius: 999px;
    background: #f2faf7;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .02em;
}
.system-tile-state i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #299173;
    box-shadow: 0 0 0 3px rgba(41,145,115,.1);
}
.system-tile-state.is-setup {
    color: #82611f;
    border-color: #ecdfc5;
    background: #fdf9ef;
}
.system-tile-state.is-setup i {
    background: #c18b26;
    box-shadow: 0 0 0 3px rgba(193,139,38,.11);
}
.system-tile-copy {
    margin-top: 11px;
    display: block;
}
.system-tile-label {
    display: block;
    color: var(--system-accent);
    font-size: .64rem;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
}
.system-tile-copy > strong {
    margin-top: 0;
    display: block;
    color: #272c33;
    font-family: "MICEI Head", "Segoe UI", sans-serif;
    font-size: .96rem;
    line-height: 1.25;
    letter-spacing: -.012em;
}
.system-tile-copy > small {
    max-width: 455px;
    margin-top: 5px;
    display: block;
    color: #747981;
    display: -webkit-box;
    overflow: hidden;
    font-size: .67rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}
.system-tile-footer {
    margin-top: auto;
    padding-top: 7px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    color: #343940;
    border-top: 1px solid #ebecef;
    font-size: .67rem;
    font-weight: 800;
}
.system-tile-arrow {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    color: var(--system-accent);
    border-radius: 50%;
    background: var(--system-accent-soft);
    transition: color .18s ease, background .18s ease, transform .18s ease;
}
.system-tile-arrow:only-child { margin-left: auto; }
.system-tile-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
