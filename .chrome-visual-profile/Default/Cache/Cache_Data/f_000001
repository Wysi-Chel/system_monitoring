    html[data-theme="dark"] .system-hub-summary strong,
    html[data-theme="dark"] .system-hub-header h1,
    html[data-theme="dark"] .system-tile-copy > strong,
    html[data-theme="dark"] .system-tile-footer { color: var(--ink); }
    html[data-theme="dark"] .system-hub-avatar { background: #4a2228; }
    html[data-theme="dark"] .system-hub-signout { color: #d3d7dc; border-color: #47505a; background: #272e35; }
    html[data-theme="dark"] .system-hub-signout:hover { color: #ffadb7; border-color: #75404a; background: #352329; }
    html[data-theme="dark"] .system-tile::after { background: radial-gradient(circle, var(--system-accent-soft) 0, transparent 69%); }
    html[data-theme="dark"] .system-tile-red { --system-accent: #ed7c88; --system-accent-soft: #47262b; }
    html[data-theme="dark"] .system-tile-amber { --system-accent: #e7aa5c; --system-accent-soft: #463521; }
    html[data-theme="dark"] .system-tile-indigo { --system-accent: #ae9ae9; --system-accent-soft: #332e4a; }
    html[data-theme="dark"] .system-tile-blue { --system-accent: #77b1e2; --system-accent-soft: #24384a; }
    html[data-theme="dark"] .system-tile-state { color: #9be0c5; border-color: #315e50; background: #203a32; }
    html[data-theme="dark"] .system-tile-state.is-setup { color: #ffd48d; border-color: #6a512c; background: #44351f; }
    html[data-theme="dark"] .system-tile-footer,
    html[data-theme="dark"] .system-hub-footer { border-color: #39414b; }
    html[data-theme="dark"] ::-webkit-scrollbar { width: 11px; height: 11px; }
    html[data-theme="dark"] ::-webkit-scrollbar-track { background: #1b2026; }
    html[data-theme="dark"] ::-webkit-scrollbar-thumb { border: 3px solid #1b2026; border-radius: 999px; background: #535d68; }
}

@media (max-width: 760px) {
    .topbar-actions { grid-template-columns: auto minmax(0, 1fr); }
    .micei-theme-toggle:not(.theme-switch) { padding-inline: 11px; }
    .topbar-actions .micei-theme-toggle [data-theme-label],
    .system-hub-account .micei-theme-toggle [data-theme-label] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .system-hub-account .micei-theme-toggle { width: 32px; min-height: 32px; padding: 0; }
    .auth-theme-toggle { top: 12px; right: 12px; }
}

.public-forms-login-link {
    margin-top: 17px;
    display: block;
    color: var(--red-dark);
    font-size: .76rem;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
}
.system-hub-public-link {
    min-height: 38px;
    padding: 8px 11px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #595e66;
    border: 1px solid #e0e3e7;
    border-radius: 999px;
    background: #fff;
    font-size: .71rem;
    font-weight: 700;
    text-decoration: none;
}
.system-hub-public-link svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
.system-hub-public-link:hover { color: var(--red-dark); border-color: #d5aeb4; }
.public-admin-filters { grid-template-columns: minmax(260px, 2fr) minmax(160px, 1fr) auto; }
.detail-toolbar { margin-bottom: 16px; padding: 0 2px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.detail-layout { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 18px; align-items: start; }
.detail-main, .detail-side { min-width: 0; display: grid; gap: 18px; }
.sticky-card { position: sticky; top: 20px; }
.section-kicker { display: block; color: var(--red-dark); font-size: .62rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
.detail-grid { margin: 0; }
.detail-grid dt, .summary-list span, .narrative > span { margin-bottom: 5px; color: var(--muted); font-size: .66rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
.detail-grid dd { margin: 0; font-size: .82rem; font-weight: 700; word-break: break-word; }
.narrative { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--line); }
.narrative p { margin: 7px 0 0; font-size: .8rem; line-height: 1.65; }
.narrative em { color: var(--muted); font-style: normal; }
.summary-list { display: grid; gap: 0; }
.summary-list > div { padding: 12px 0; display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; border-bottom: 1px solid var(--line); }
.summary-list > div:first-child { padding-top: 0; }
.summary-list > div:last-child { border-bottom: 0; }
.summary-list span { margin: 0; flex: 0 0 38%; }
.summary-list strong { font-size: .74rem; text-align: right; overflow-wrap: anywhere; }
.btn-block { width: 100%; }
.convert-request-form { margin-top: 12px; padding-top: 14px; border-top: 1px solid var(--line); }
.public-admin-images { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.public-admin-images a { min-height: 220px; padding: 13px; display: flex; flex-direction: column; color: var(--ink); border: 1px solid var(--line); border-radius: 16px; background: #f8f9fa; text-decoration: none; }
.public-admin-images span { margin-bottom: 10px; color: var(--red-dark); font-size: .68rem; font-weight: 800; text-transform: uppercase; }
.public-admin-images img { width: 100%; height: 220px; object-fit: contain; border-radius: 10px; background: #fff; }
.badge-request-pending { color: #6b4b00; background: #fff2cb; }
.badge-request-under-review { color: #6842a0; background: #eee6fb; }
.badge-request-approved { color: #255d97; background: #e1efff; }
.badge-request-converted { color: #136248; background: #ddf4ea; }
.badge-request-declined { color: #a12431; background: #fbe2e5; }
.badge-request-cancelled { color: #666b73; background: #eceef1; }

@media screen {
    html[data-theme="dark"] .system-hub-public-link { color: #d3d7dc; border-color: #47505a; background: #272e35; }
    html[data-theme="dark"] .public-admin-images a { color: var(--ink); border-color: var(--line); background: #1c2127; }
    html[data-theme="dark"] .public-admin-images img { background: #fff; }
    html[data-theme="dark"] .badge-request-pending { color: #ffd48d; background: #4b351d; }
    html[data-theme="dark"] .badge-request-under-review { color: #d5b7ff; background: #3c2d51; }
    html[data-theme="dark"] .badge-request-approved { color: #a9d1ff; background: #243c58; }
    html[data-theme="dark"] .badge-request-converted { color: #9be0c5; background: #203e34; }
    html[data-theme="dark"] .badge-request-declined { color: #ffabb4; background: #4b252b; }
    html[data-theme="dark"] .badge-request-cancelled { color: #c4cad1; background: #3a4048; }
}

@media (max-width: 900px) {
    .detail-layout { grid-template-columns: 1fr; }
    .sticky-card { position: static; }
}
@media (max-width: 760px) {
    .public-admin-filters { grid-template-columns: 1fr; }
    .detail-toolbar { align-items: flex-start; flex-direction: column; }
    .public-admin-images { grid-template-columns: 1fr; }
    .system-hub-public-link { width: 32px; min-height: 32px; padding: 0; justify-content: center; }
    .system-hub-public-link span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
}
